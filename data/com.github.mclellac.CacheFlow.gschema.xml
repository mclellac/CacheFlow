<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="cacheflow">
  <schema id="com.github.mclellac.CacheFlow" path="/com/github/mclellac/CacheFlow/">
    <key name="user-agent" type="s">
      <default>'CacheFlow/0.1.0'</default>
      <summary>User-Agent for requests</summary>
    </key>
    <key name="test-path" type="s">
      <default>'/'</default>
      <summary>The last used test path</summary>
    </key>
    <key name="active-environment" type="s">
      <default>'production'</default>
      <summary>The currently active environment</summary>
    </key>
    <key name="node-font" type="s">
      <default>'Monospace 14'</default>
      <summary>The font used for node content</summary>
    </key>
    <key name="theme" type="s">
      <default>'system'</default>
      <summary>The application color scheme</summary>
    </key>
    <key name="dns-servers" type="s">
      <default>''</default>
      <summary>Comma-separated list of DNS servers to use for resolution.</summary>
    </key>
    <key name="config-production" type="aa{sv}">
      <default>[]</default>
      <summary>Configuration for the Production environment</summary>
    </key>
    <key name="config-staging" type="aa{sv}">
      <default>[]</default>
      <summary>Configuration for the Staging environment</summary>
    </key>
    <key name="config-qa" type="aa{sv}">
      <default>[]</default>
      <summary>Configuration for the QA environment</summary>
    </key>
    <key name="config-dev" type="aa{sv}">
      <default>[]</default>
      <summary>Configuration for the Dev environment</summary>
    </key>
  </schema>
</schemalist>
