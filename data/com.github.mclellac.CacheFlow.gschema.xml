<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="cacheflow">
  <schema id="com.github.mclellac.CacheFlow" path="/com/github/mclellac/CacheFlow/">
    <key name="user-agent" type="s">
      <default>'CacheFlow/0.1.0'</default>
      <summary>User-Agent for requests</summary>
    </key>
    <key name="test-path" type="s">
      <default>'/'</default>
      <summary>The last used test path</summary>
    </key>
    <key name="active-config-id" type="s">
      <default>''</default>
      <summary>The currently active configuration ID</summary>
    </key>
    <key name="node-font" type="s">
      <default>'Monospace 14'</default>
      <summary>The font used for node content</summary>
    </key>
    <key name="theme" type="s">
      <default>'system'</default>
      <summary>The application color scheme</summary>
    </key>
    <key name="dns-servers" type="s">
      <default>''</default>
      <summary>Comma-separated list of DNS servers to use for resolution.</summary>
    </key>
    <key name="verify-ssl" type="b">
      <default>false</default>
      <summary>Whether to verify SSL certificates</summary>
    </key>
    <key name="configurations" type="aa{sv}">
      <default>[]</default>
      <summary>List of domain configurations</summary>
    </key>
    <key name="window-width" type="i">
      <default>-1</default>
      <summary>The width of the main window</summary>
    </key>
    <key name="window-height" type="i">
      <default>-1</default>
      <summary>The height of the main window</summary>
    </key>
    <key name="header-dialog-width" type="i">
      <default>600</default>
      <summary>The width of the header dialog</summary>
    </key>
    <key name="header-dialog-height" type="i">
      <default>400</default>
      <summary>The height of the header dialog</summary>
    </key>
    <key name="analyzer-width" type="i">
      <default>800</default>
      <summary>The width of the analyzer window</summary>
    </key>
    <key name="analyzer-height" type="i">
      <default>600</default>
      <summary>The height of the analyzer window</summary>
    </key>
  </schema>
</schemalist>
