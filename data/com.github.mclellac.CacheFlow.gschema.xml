<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="cacheflow">
  <schema id="com.github.mclellac.CacheFlow" path="/com/github/mclellac/CacheFlow/">

    <!-- Global Settings -->
    <key name="user-agent" type="s">
      <default>'HTTP-Header-Inspector/1.0 (Python)'</default>
      <summary>User Agent</summary>
      <description>The user agent string used for requests.</description>
    </key>
    <key name="test-path" type="s">
      <default>'/products/widget-x'</default>
      <summary>Test Path</summary>
      <description>The default path to inspect.</description>
    </key>
    <key name="theme" type="s">
      <default>'system'</default>
      <summary>Application Theme</summary>
      <description>Theme variant: system, light, or dark.</description>
    </key>
    <key name="dns-servers" type="s">
      <default>''</default>
      <summary>DNS Servers</summary>
      <description>Comma-separated list of DNS servers to use. Empty for system default.</description>
    </key>
    <key name="active-environment" type="s">
      <default>'production'</default>
      <summary>Active Environment</summary>
      <description>The currently selected environment (production, staging, qa, dev).</description>
    </key>

    <!-- Environment Configurations -->
    <key name="config-production" type="s">
      <default>''</default>
      <summary>Production Configuration</summary>
      <description>YAML config for Production.</description>
    </key>
    <key name="config-staging" type="s">
      <default>''</default>
      <summary>Staging Configuration</summary>
      <description>YAML config for Staging.</description>
    </key>
    <key name="config-qa" type="s">
      <default>''</default>
      <summary>QA Configuration</summary>
      <description>YAML config for QA.</description>
    </key>
    <key name="config-dev" type="s">
      <default>''</default>
      <summary>Development Configuration</summary>
      <description>YAML config for Development.</description>
    </key>

  </schema>
</schemalist>
