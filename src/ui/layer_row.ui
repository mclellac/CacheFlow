<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="LayerRow" parent="AdwPreferencesGroup">
    <property name="title">Layer Name</property>
    <property name="description">New Layer</property>

    <property name="header-suffix">
      <object class="GtkButton" id="delete_btn">
        <property name="valign">center</property>
        <property name="tooltip-text">Delete Layer</property>
        <child>
          <object class="AdwButtonContent">
            <property name="icon-name">user-trash-symbolic</property>
          </object>
        </child>
        <style>
          <class name="destructive-action"/>
        </style>
      </object>
    </property>

    <child>
      <object class="AdwComboRow" id="type_row">
        <property name="title">Layer Type</property>
      </object>
    </child>
    <child>
      <object class="AdwComboRow" id="provider_row">
        <property name="title">Provider</property>
        <child type="suffix">
            <object class="GtkButton" id="preset_btn">
                <property name="valign">center</property>
                <property name="icon-name">document-open-symbolic</property>
                <property name="tooltip-text">Load Preset</property>
                <style>
                    <class name="flat"/>
                </style>
            </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwEntryRow" id="name_row">
        <property name="title">Name</property>
      </object>
    </child>
    <child>
      <object class="AdwEntryRow" id="desc_row">
        <property name="title">Description</property>
      </object>
    </child>
    <child>
      <object class="AdwEntryRow" id="url_row">
        <property name="title">Host URL</property>
      </object>
    </child>

    <child>
        <object class="AdwEntryRow" id="default_backend_host_row">
            <property name="title">Host</property>
        </object>
    </child>
    <child>
        <object class="AdwEntryRow" id="default_backend_header_row">
            <property name="title">Host Header (Optional)</property>
        </object>
    </child>

    <child>
      <object class="AdwExpanderRow" id="nodes_group">
        <property name="title">Servers</property>
        <property name="subtitle">Configure multiple servers for this layer.</property>
        <child>
            <object class="AdwActionRow" id="add_node_row">
                <property name="title">Add New Server</property>
                <property name="icon-name">list-add-symbolic</property>
                <child type="suffix">
                    <object class="GtkButton" id="add_node_btn">
                        <property name="valign">center</property>
                        <property name="tooltip-text">Add Server</property>
                        <child>
                            <object class="AdwButtonContent">
                                <property name="icon-name">list-add-symbolic</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwExpanderRow" id="routing_rules_group">
        <property name="title">Traffic Rules</property>
        <property name="subtitle">Define rules to direct traffic.</property>
        <child>
            <object class="AdwActionRow" id="add_routing_rule_row">
                <property name="title">Add New Rule</property>
                <property name="icon-name">list-add-symbolic</property>
                <child type="suffix">
                    <object class="GtkButton" id="add_routing_rule_btn">
                        <property name="valign">center</property>
                        <property name="tooltip-text">Add Routing Rule</property>
                        <child>
                            <object class="AdwButtonContent">
                                <property name="icon-name">list-add-symbolic</property>
                            </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwExpanderRow" id="advanced_group">
        <property name="title">Advanced Settings</property>
        <property name="subtitle">Colors, Headers, and Overrides.</property>

        <child>
          <object class="AdwActionRow" id="header_color_row">
            <property name="title">Header Color</property>
            <child type="suffix">
              <object class="GtkColorButton" id="header_color_button">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="body_color_row">
            <property name="title">Body Color</property>
            <child type="suffix">
              <object class="GtkColorButton" id="body_color_button">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="text_color_row">
            <property name="title">Default Text Color</property>
            <child type="suffix">
              <object class="GtkColorButton" id="text_color_button">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwActionRow" id="added_text_color_row">
            <property name="visible">False</property>
            <property name="title">Added Text Color</property>
            <child type="suffix">
              <object class="GtkColorButton" id="added_text_color_button">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="removed_text_color_row">
            <property name="visible">False</property>
            <property name="title">Removed Text Color</property>
            <child type="suffix">
              <object class="GtkColorButton" id="removed_text_color_button">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="modified_text_color_row">
            <property name="visible">False</property>
            <property name="title">Modified Text Color</property>
            <child type="suffix">
              <object class="GtkColorButton" id="modified_text_color_button">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwExpanderRow" id="headers_group">
            <property name="title">Custom Headers</property>
            <property name="subtitle">Inject or override headers for requests to this layer.</property>
            <child>
                <object class="AdwActionRow" id="add_header_row">
                    <property name="title">Add New Header</property>
                    <property name="icon-name">list-add-symbolic</property>
                    <child type="suffix">
                        <object class="GtkButton" id="add_header_btn">
                            <property name="valign">center</property>
                            <property name="tooltip-text">Add Header</property>
                            <child>
                                <object class="AdwButtonContent">
                                    <property name="icon-name">list-add-symbolic</property>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwExpanderRow" id="overrides_group">
            <property name="title">Host Header Override</property>
            <property name="subtitle">Force a different Host header for specific path patterns.</property>
            <child>
                <object class="AdwActionRow" id="add_override_row">
                    <property name="title">Add New Override</property>
                    <property name="icon-name">list-add-symbolic</property>
                    <child type="suffix">
                        <object class="GtkButton" id="add_override_btn">
                            <property name="valign">center</property>
                            <property name="tooltip-text">Add Host Override</property>
                            <child>
                                <object class="AdwButtonContent">
                                    <property name="icon-name">list-add-symbolic</property>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwExpanderRow" id="path_match_group">
            <property name="title">Path Match Only</property>
            <property name="subtitle">Only process requests where the path matches one of these patterns.</property>
            <child>
                <object class="AdwActionRow" id="add_path_match_row">
                    <property name="title">Add New Path Match</property>
                    <property name="icon-name">list-add-symbolic</property>
                    <child type="suffix">
                        <object class="GtkButton" id="add_path_match_btn">
                            <property name="valign">center</property>
                            <property name="tooltip-text">Add Path Pattern</property>
                            <child>
                                <object class="AdwButtonContent">
                                    <property name="icon-name">list-add-symbolic</property>
                                </object>
                            </child>
                        </object>
                    </child>
                </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
