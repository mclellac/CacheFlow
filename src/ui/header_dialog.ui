<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="HeaderDialog" parent="AdwDialog">
    <property name="content-width">800</property>
    <property name="content-height">600</property>
    <child type="title">
      <object class="AdwHeaderBar">
        <child type="title">
          <object class="AdwWindowTitle" id="window_title">
            <property name="title">Headers</property>
          </object>
        </child>
        <child>
          <object class="GtkSearchEntry" id="search_entry">
            <property name="hexpand">True</property>
            <property name="placeholder-text">Search Headers</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkButton" id="analyze_button">
            <property name="visible">True</property>
            <property name="tooltip-text">Analyze Headers</property>
            <child>
              <object class="AdwButtonContent">
                <property name="icon-name">system-search-symbolic</property>
                <property name="label">Analyze</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkStack" id="stack">
        <child>
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <child>
              <object class="GtkColumnView" id="column_view">
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="show-column-separators">True</property>
                <child>
                  <object class="GtkColumnViewColumn" id="column_key">
                    <property name="title">Header</property>
                    <property name="expand">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkColumnViewColumn" id="column_value">
                    <property name="title">Value</property>
                    <property name="expand">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkColumnViewColumn" id="column_note">
                    <property name="title">Note</property>
                    <property name="expand">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing>
            <property name="name">list</property>
          </packing>
        </child>
        <child>
          <object class="AdwStatusPage">
            <property name="title">No Headers Found</property>
            <property name="description">No headers matched your search.</property>
            <property name="icon-name">edit-find-symbolic</property>
          </object>
          <packing>
            <property name="name">empty</property>
          </packing>
        </child>
      </object>
    </child>
  </template>
</interface>
