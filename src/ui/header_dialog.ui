<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="HeaderDialog" parent="Adw.Dialog">
    <property name="presentation-mode">floating</property>
    <property name="content-width">700</property>
    <property name="content-height">600</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-end-title-buttons">True</property>
            <child type="title">
              <object class="AdwWindowTitle" id="window_title">
                <property name="title">Headers</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="analyze_button">
                <property name="tooltip-text">Analyze headers for issues</property>
                <property name="child">
                  <object class="AdwButtonContent">
                    <property name="icon-name">system-search-symbolic</property>
                    <property name="label">Analyze</property>
                  </object>
                </property>
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
          </object>
        </child>

        <property name="content">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
                <object class="GtkSearchEntry" id="search_entry">
                    <property name="placeholder-text">Search headers...</property>
                    <property name="hexpand">True</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="margin-start">6</property>
                    <property name="margin-end">6</property>
                </object>
            </child>
            <child>
              <object class="GtkStack" id="stack">
                <child>
                    <object class="GtkStackPage">
                      <property name="name">list</property>
                        <property name="child">
                          <object class="GtkScrolledWindow">
                            <child>
                              <object class="GtkColumnView" id="column_view">
                                <property name="hexpand">True</property>
                                <property name="show-row-separators">True</property>
                                <property name="show-column-separators">True</property>

                                <child>
                                  <object class="GtkColumnViewColumn" id="column_key">
                                    <property name="title">Header</property>
                                    <property name="resizable">True</property>
                                    <property name="expand">False</property>
                                    <property name="fixed-width">200</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkColumnViewColumn" id="column_value">
                                    <property name="title">Value</property>
                                    <property name="resizable">True</property>
                                    <property name="expand">True</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkColumnViewColumn" id="column_note">
                                    <property name="title">Notes</property>
                                    <property name="resizable">True</property>
                                    <property name="expand">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                    </object>
                </child>
                <child>
                    <object class="GtkStackPage">
                        <property name="name">empty</property>
                        <property name="child">
                            <object class="AdwStatusPage">
                                <property name="icon-name">system-search-symbolic</property>
                                <property name="title">No Headers Found</property>
                            </object>
                        </property>
                    </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>