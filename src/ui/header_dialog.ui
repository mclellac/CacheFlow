<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="HeaderDialog" parent="AdwMessageDialog">
    <property name="default-response">close</property>
    <property name="close-response">close</property>
    <property name="extra-child">
      <object class="GtkScrolledWindow">
        <property name="vexpand">True</property>
        <property name="min-content-height">400</property>
        <child>
          <object class="GtkColumnView" id="column_view">
            <property name="hexpand">True</property>
            <property name="show-row-separators">True</property>
            <property name="show-column-separators">True</property>

            <child>
              <object class="GtkColumnViewColumn" id="column_key">
                <property name="title">Header</property>
                <property name="resizable">True</property>
                <property name="expand">False</property>
                <property name="fixed-width">150</property>
              </object>
            </child>
            <child>
              <object class="GtkColumnViewColumn" id="column_value">
                <property name="title">Value</property>
                <property name="resizable">True</property>
                <property name="expand">True</property>
              </object>
            </child>
            <child>
              <object class="GtkColumnViewColumn" id="column_note">
                <property name="title">Notes</property>
                <property name="resizable">True</property>
                <property name="expand">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
    <responses>
      <response id="close" translatable="yes">Close</response>
    </responses>
  </template>
</interface>
