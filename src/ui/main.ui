<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="Window" parent="AdwApplicationWindow">
    <property name="default-width">1400</property>
    <property name="default-height">900</property>
    <property name="title">CacheFlow</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar" id="header_bar">
            <child type="title">
              <object class="AdwWindowTitle">
                <property name="title">CacheFlow</property>
              </object>
            </child>
            <child type="start">
              <object class="GtkDropDown" id="config_switcher">
                <property name="tooltip-text">Switch Domain</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="show_all_nodes_button">
                <property name="icon-name">view-grid-symbolic</property>
                <property name="tooltip-text" translatable="yes">Show All Configured Infrastructure</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="show_labels_button">
                <property name="icon-name">text-x-generic-symbolic</property>
                <property name="tooltip-text" translatable="yes">Show Connection Labels</property>
                <property name="active">True</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkToggleButton" id="show_animation_button">
                <property name="icon-name">media-playback-start-symbolic</property>
                <property name="tooltip-text" translatable="yes">Show Network Animation</property>
                <property name="active">True</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="menu-model">
                  <menu>
                    <section>
                      <item>
                        <attribute name="label" translatable="yes">Inspect Path</attribute>
                        <attribute name="action">win.inspect</attribute>
                      </item>
                    </section>
                    <section>
                      <item>
                        <attribute name="label" translatable="yes">Export Graph...</attribute>
                        <attribute name="action">win.export-graph</attribute>
                      </item>
                      <item>
                        <attribute name="label" translatable="yes">Reset Layout</attribute>
                        <attribute name="action">win.reset-layout</attribute>
                      </item>
                    </section>
                    <section>
                      <item>
                        <attribute name="label" translatable="yes">Preferences</attribute>
                        <attribute name="action">app.preferences</attribute>
                      </item>
                      <item>
                        <attribute name="label" translatable="yes">Header Encyclopedia</attribute>
                        <attribute name="action">app.encyclopedia</attribute>
                      </item>
                      <item>
                        <attribute name="label" translatable="yes">Keyboard Shortcuts</attribute>
                        <attribute name="action">app.shortcuts</attribute>
                      </item>
                    </section>
                    <section>
                      <item>
                        <attribute name="label" translatable="yes">About</attribute>
                        <attribute name="action">app.about</attribute>
                      </item>
                    </section>
                  </menu>
                </property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>

                <!-- Action Bar (Path Entry) -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="margin-start">6</property>
                    <property name="margin-end">6</property>
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <child>
                      <object class="GtkLabel" id="env_label">
                        <property name="label">https://example.com</property>
                        <property name="margin-end">6</property>
                        <property name="css-classes">dim-label</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="path_entry">
                        <property name="placeholder-text">/path/to/inspect</property>
                        <property name="hexpand">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="inspect_button">
                        <property name="css-classes">suggested-action</property>
                        <child>
                          <object class="AdwButtonContent">
                            <property name="label">Inspect</property>
                            <property name="icon-name">system-search-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSpinner" id="spinner">
                        <property name="visible">False</property>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Main Content (Stack) -->
                <child>
                  <object class="GtkStack" id="content_stack">
                    <property name="vexpand">True</property>
                    <property name="transition-type">crossfade</property>

                    <!-- Empty State -->
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">empty</property>
                        <property name="child">
                          <object class="AdwStatusPage" id="status_page">
                            <property name="icon-name">network-server-symbolic</property>
                            <property name="title">Ready to Inspect</property>
                            <property name="description">Enter a URL path and click Inspect to visualize the cache flow.</property>
                            <property name="child">
                                <object class="GtkButton" id="status_action_btn">
                                    <property name="label">Create Configuration</property>
                                    <property name="visible">False</property>
                                    <property name="halign">center</property>
                                    <style><class name="pill"/><class name="suggested-action"/></style>
                                </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>

                    <!-- Graph -->
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">graph</property>
                        <property name="child">
                          <object class="NodeGraph" id="node_graph"/>
                        </property>
                      </object>
                    </child>

                  </object>
                </child>

              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>