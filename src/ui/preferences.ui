<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="PreferencesWindow" parent="AdwPreferencesWindow">
    <property name="title">Preferences</property>

    <!-- General Settings -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Application</property>
        <property name="icon-name">preferences-system-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Appearance</property>
            <child>
               <object class="AdwComboRow" id="theme_row">
                 <property name="title">Theme</property>
                 <property name="model">
                   <object class="GtkStringList">
                     <items>
                       <item>System</item>
                       <item>Light</item>
                       <item>Dark</item>
                     </items>
                   </object>
                 </property>
               </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Network</property>
            <child>
               <object class="AdwSwitchRow" id="ssl_row">
                 <property name="title">Verify SSL</property>
               </object>
            </child>
            <child>
               <object class="AdwEntryRow" id="dns_row">
                 <property name="title">DNS Servers</property>
                 <property name="tooltip-text">Comma-separated list of DNS servers (e.g., 8.8.8.8, 1.1.1.1)</property>
                 <property name="show-apply-button">True</property>
               </object>
            </child>
          </object>
        </child>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title">Node Font</property>
                <child>
                  <object class="GtkFontButton" id="font_button"/>
                </child>
            </object>
        </child>
      </object>
    </child>

    <!-- Configurations (Domains) -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Configurations</property>
        <property name="icon-name">network-workgroup-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup" id="configurations_group">
            <property name="title">Domain Configurations</property>
            <property name="description">Manage sets of layer configurations for different domains.</property>
            <child>
                <object class="AdwComboRow" id="config_selector">
                    <property name="title">Active Configuration</property>
                </object>
            </child>
            <child>
                <object class="AdwActionRow" id="config_actions_row">
                    <property name="title">Manage Configurations</property>
                    <property name="activatable">False</property>
                    <child type="suffix">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton" id="add_config_btn">
                            <property name="tooltip-text">Add New Domain</property>
                            <child>
                              <object class="AdwButtonContent">
                                <property name="icon-name">list-add-symbolic</property>
                                <property name="label">Add</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="delete_config_btn">
                            <property name="tooltip-text">Delete Selected Domain</property>
                            <child>
                              <object class="AdwButtonContent">
                                <property name="icon-name">user-trash-symbolic</property>
                                <property name="label">Delete</property>
                              </object>
                            </child>
                            <style>
                              <class name="destructive-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                </object>
            </child>
          </object>
        </child>
        <child>
            <object class="AdwPreferencesGroup" id="details_group">
                <property name="title">Domain Details</property>
                <property name="description">Basic information for the selected domain configuration.</property>
                <child>
                    <object class="AdwEntryRow" id="domain_name_row">
                        <property name="title">Domain Name</property>
                    </object>
                </child>
            </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Infrastructure Layers</property>
            <property name="description">Configure the layers of your infrastructure. The inspection follows the order: CDN → Load Balancer → Caching Proxy → Application.</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="AdwViewSwitcher">
                    <property name="stack">layers_stack</property>
                    <property name="policy">wide</property>
                  </object>
                </child>
                <child>
                  <object class="AdwViewStack" id="layers_stack">
                    <child>
                      <object class="AdwViewStackPage">
                        <property name="name">page_cdn</property>
                        <property name="title">CDN</property>
                        <property name="icon-name">network-server-symbolic</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">24</property>
                            <child>
                              <object class="GtkBox" id="group_cdn">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="description">Content Delivery Network layers (Entry Points).</property>
                                <child>
                                  <object class="AdwActionRow" id="add_cdn_row">
                                    <property name="title">Add CDN Layer</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="activatable">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwViewStackPage">
                        <property name="name">page_lb</property>
                        <property name="title">Load Balancer</property>
                        <property name="icon-name">network-transmit-receive-symbolic</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">24</property>
                            <child>
                              <object class="GtkBox" id="group_lb">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="description">Traffic distribution layers (e.g., Nginx, HAProxy).</property>
                                <child>
                                  <object class="AdwActionRow" id="add_lb_row">
                                    <property name="title">Add Load Balancer Layer</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="activatable">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwViewStackPage">
                        <property name="name">page_proxy</property>
                        <property name="title">Caching Proxy</property>
                        <property name="icon-name">drive-harddisk-symbolic</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">24</property>
                            <child>
                              <object class="GtkBox" id="group_proxy">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="description">Caching layers (e.g., Varnish) sitting between LB and App.</property>
                                <child>
                                  <object class="AdwActionRow" id="add_proxy_row">
                                    <property name="title">Add Proxy Layer</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="activatable">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwViewStackPage">
                        <property name="name">page_app</property>
                        <property name="title">Application</property>
                        <property name="icon-name">application-x-executable-symbolic</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">24</property>
                            <child>
                              <object class="GtkBox" id="group_app">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <property name="description">Origin Application Backends (e.g., Web Servers).</property>
                                <child>
                                  <object class="AdwActionRow" id="add_app_row">
                                    <property name="title">Add Application Layer</property>
                                    <property name="icon-name">list-add-symbolic</property>
                                    <property name="activatable">True</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
            <object class="AdwPreferencesGroup" id="import_export_group">
                <property name="title">Configuration Data</property>
                <property name="description">Save or replace the layers of the current domain from a YAML file.</property>
                <child>
                    <object class="AdwActionRow" id="export_row">
                        <property name="title">Export Layers</property>
                        <property name="icon-name">document-save-as-symbolic</property>
                        <property name="activatable">True</property>
                    </object>
                </child>
                <child>
                    <object class="AdwActionRow" id="import_row">
                        <property name="title">Import Layers</property>
                        <property name="icon-name">document-open-symbolic</property>
                        <property name="activatable">True</property>
                    </object>
                </child>
            </object>
        </child>
      </object>
    </child>

  </template>
</interface>
