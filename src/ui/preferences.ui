<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="PreferencesWindow" parent="AdwPreferencesWindow">
    <property name="title">Preferences</property>

    <!-- General Settings -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Application</property>
        <property name="icon-name">preferences-system-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Appearance</property>
            <child>
               <object class="AdwComboRow" id="theme_row">
                 <property name="title">Theme</property>
                 <property name="model">
                   <object class="GtkStringList">
                     <items>
                       <item>System</item>
                       <item>Light</item>
                       <item>Dark</item>
                     </items>
                   </object>
                 </property>
               </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Network</property>
            <child>
               <object class="AdwEntryRow" id="dns_row">
                 <property name="title">DNS Servers</property>
                 <property name="tooltip-text">Comma-separated list of DNS servers (e.g., 8.8.8.8, 1.1.1.1)</property>
                 <property name="show-apply-button">True</property>
               </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Production Environment -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Production</property>
        <property name="icon-name">network-server-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Configuration</property>
            <property name="description">Define layers and infrastructure headers.</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="height-request">400</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">True</property>
                    <property name="child">
                      <object class="GtkTextView" id="config_prod_view">
                        <property name="monospace">True</property>
                        <property name="top-margin">10</property>
                        <property name="bottom-margin">10</property>
                        <property name="left-margin">10</property>
                        <property name="right-margin">10</property>
                        <property name="wrap-mode">word</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Staging Environment -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Staging</property>
        <property name="icon-name">folder-publicshare-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
             <property name="title">Configuration</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="height-request">400</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">True</property>
                    <property name="child">
                      <object class="GtkTextView" id="config_staging_view">
                        <property name="monospace">True</property>
                        <property name="top-margin">10</property>
                        <property name="bottom-margin">10</property>
                        <property name="left-margin">10</property>
                        <property name="right-margin">10</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- QA Environment -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">QA</property>
        <property name="icon-name">user-available-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
             <property name="title">Configuration</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="height-request">400</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">True</property>
                    <property name="child">
                      <object class="GtkTextView" id="config_qa_view">
                        <property name="monospace">True</property>
                        <property name="top-margin">10</property>
                        <property name="bottom-margin">10</property>
                        <property name="left-margin">10</property>
                        <property name="right-margin">10</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Dev Environment -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Dev</property>
        <property name="icon-name">applications-development-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
             <property name="title">Configuration</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="height-request">400</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">True</property>
                    <property name="child">
                      <object class="GtkTextView" id="config_dev_view">
                        <property name="monospace">True</property>
                        <property name="top-margin">10</property>
                        <property name="bottom-margin">10</property>
                        <property name="left-margin">10</property>
                        <property name="right-margin">10</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

  </template>
</interface>
