<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="PreferencesWindow" parent="AdwPreferencesWindow">
    <property name="title">Preferences</property>

    <!-- General Settings -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Application</property>
        <property name="icon-name">preferences-system-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Appearance</property>
            <child>
               <object class="AdwComboRow" id="theme_row">
                 <property name="title">Theme</property>
                 <property name="model">
                   <object class="GtkStringList">
                     <items>
                       <item>System</item>
                       <item>Light</item>
                       <item>Dark</item>
                     </items>
                   </object>
                 </property>
               </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Network</property>
            <child>
               <object class="AdwSwitchRow" id="ssl_row">
                 <property name="title">Verify SSL</property>
                 <property name="subtitle">Enforce certificate validation</property>
               </object>
            </child>
            <child>
               <object class="AdwEntryRow" id="dns_row">
                 <property name="title">DNS Servers</property>
                 <property name="tooltip-text">Comma-separated list of DNS servers (e.g., 8.8.8.8, 1.1.1.1)</property>
                 <property name="show-apply-button">True</property>
               </object>
            </child>
          </object>
        </child>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title">Node Font</property>
                <child>
                  <object class="GtkFontButton" id="font_button"/>
                </child>
            </object>
        </child>
      </object>
    </child>

    <!-- Configurations (Domains) -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Configurations</property>
        <property name="icon-name">network-workgroup-symbolic</property>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title">Select Configuration</property>
                <child>
                    <object class="AdwComboRow" id="config_selector">
                        <property name="title">Domain</property>
                        <property name="subtitle">Select a domain configuration to edit</property>
                        <property name="model">
                           <object class="GtkStringList"/>
                        </property>
                        <child type="suffix">
                           <object class="GtkButton" id="add_config_btn">
                               <property name="icon-name">list-add-symbolic</property>
                               <property name="valign">center</property>
                               <property name="has-frame">False</property>
                               <property name="tooltip-text">Add New Configuration</property>
                           </object>
                        </child>
                         <child type="suffix">
                           <object class="GtkButton" id="delete_config_btn">
                               <property name="icon-name">user-trash-symbolic</property>
                               <property name="valign">center</property>
                               <property name="has-frame">False</property>
                               <property name="tooltip-text">Delete Configuration</property>
                               <style>
                                   <class name="destructive-action"/>
                               </style>
                           </object>
                        </child>
                    </object>
                </child>
            </object>
        </child>

        <child>
            <object class="AdwPreferencesGroup">
                <property name="title">Domain Details</property>
                <child>
                    <object class="AdwEntryRow" id="domain_name_row">
                        <property name="title">Domain Name</property>
                    </object>
                </child>
            </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup" id="layers_group">
            <property name="title">Layers</property>
            <property name="description">Define layers for this domain.</property>
            <child>
               <object class="AdwActionRow" id="add_layer_row">
                   <property name="title">Add New Layer</property>
                   <property name="activatable">True</property>
                   <child type="prefix">
                        <object class="GtkImage">
                            <property name="icon-name">list-add-symbolic</property>
                        </object>
                   </child>
               </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Actions</property>
            <child>
               <object class="AdwActionRow" id="export_row">
                   <property name="title">Export to YAML</property>
                   <property name="activatable">True</property>
                   <child type="prefix">
                        <object class="GtkImage">
                            <property name="icon-name">document-save-symbolic</property>
                        </object>
                   </child>
               </object>
            </child>
            <child>
               <object class="AdwActionRow" id="import_row">
                   <property name="title">Import from YAML</property>
                   <property name="activatable">True</property>
                   <child type="prefix">
                        <object class="GtkImage">
                            <property name="icon-name">document-open-symbolic</property>
                        </object>
                   </child>
               </object>
            </child>
          </object>
        </child>
      </object>
    </child>

  </template>
</interface>
