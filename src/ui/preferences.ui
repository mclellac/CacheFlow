<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="PreferencesWindow" parent="AdwPreferencesWindow">
    <property name="title">Preferences</property>

    <!-- General Settings -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Application</property>
        <property name="icon-name">preferences-system-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Appearance</property>
            <child>
               <object class="AdwComboRow" id="theme_row">
                 <property name="title">Theme</property>
                 <property name="model">
                   <object class="GtkStringList">
                     <items>
                       <item>System</item>
                       <item>Light</item>
                       <item>Dark</item>
                     </items>
                   </object>
                 </property>
               </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Colors</property>
            <property name="description">Set custom colors for the node graph. Changes require a restart to fully apply.</property>
            <child>
               <object class="AdwActionRow">
                 <property name="title">Node Body (Light)</property>
                 <child type="suffix">
                   <object class="GtkColorButton" id="light_body_color_button"/>
                 </child>
               </object>
            </child>
            <child>
               <object class="AdwActionRow">
                 <property name="title">Node Header (Light)</property>
                 <child type="suffix">
                   <object class="GtkColorButton" id="light_header_color_button"/>
                 </child>
               </object>
            </child>
            <child>
               <object class="AdwActionRow">
                 <property name="title">Text (Light)</property>
                 <child type="suffix">
                   <object class="GtkColorButton" id="light_text_color_button"/>
                 </child>
               </object>
            </child>
            <child>
               <object class="AdwActionRow">
                 <property name="title">Diff Text (Light)</property>
                 <child type="suffix">
                   <object class="GtkColorButton" id="light_text_diff_color_button"/>
                 </child>
               </object>
            </child>
            <child>
               <object class="AdwActionRow">
                 <property name="title">Node Body (Dark)</property>
                 <child type="suffix">
                   <object class="GtkColorButton" id="dark_body_color_button"/>
                 </child>
               </object>
            </child>
            <child>
               <object class="AdwActionRow">
                 <property name="title">Node Header (Dark)</property>
                 <child type="suffix">
                   <object class="GtkColorButton" id="dark_header_color_button"/>
                 </child>
               </object>
            </child>
            <child>
               <object class="AdwActionRow">
                 <property name="title">Text (Dark)</property>
                 <child type="suffix">
                   <object class="GtkColorButton" id="dark_text_color_button"/>
                 </child>
               </object>
            </child>
            <child>
               <object class="AdwActionRow">
                 <property name="title">Diff Text (Dark)</property>
                 <child type="suffix">
                   <object class="GtkColorButton" id="dark_text_diff_color_button"/>
                 </child>
               </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Network</property>
            <child>
               <object class="AdwEntryRow" id="dns_row">
                 <property name="title">DNS Servers</property>
                 <property name="tooltip-text">Comma-separated list of DNS servers (e.g., 8.8.8.8, 1.1.1.1)</property>
                 <property name="show-apply-button">True</property>
               </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Font Settings -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Fonts</property>
        <property name="icon-name">font-select-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Node Font</property>
            <child>
              <object class="GtkFontButton" id="font_button"/>
            </child>
          </object>
        </child>
      </object>
    </child>
    <!-- Production Environment -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Production</property>
        <property name="icon-name">network-server-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup" id="prod_group">
            <property name="title">Layers</property>
            <property name="description">Define layers and infrastructure headers.</property>
            <child>
               <object class="AdwActionRow" id="prod_add_row">
                   <property name="title">Add New Layer</property>
                   <property name="activatable">True</property>
                   <child type="prefix">
                        <object class="GtkImage">
                            <property name="icon-name">list-add-symbolic</property>
                        </object>
                   </child>
               </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Staging Environment -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Staging</property>
        <property name="icon-name">folder-publicshare-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup" id="staging_group">
             <property name="title">Layers</property>
            <child>
               <object class="AdwActionRow" id="staging_add_row">
                   <property name="title">Add New Layer</property>
                   <property name="activatable">True</property>
                   <child type="prefix">
                        <object class="GtkImage">
                            <property name="icon-name">list-add-symbolic</property>
                        </object>
                   </child>
               </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- QA Environment -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">QA</property>
        <property name="icon-name">user-available-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup" id="qa_group">
             <property name="title">Layers</property>
            <child>
               <object class="AdwActionRow" id="qa_add_row">
                   <property name="title">Add New Layer</property>
                   <property name="activatable">True</property>
                   <child type="prefix">
                        <object class="GtkImage">
                            <property name="icon-name">list-add-symbolic</property>
                        </object>
                   </child>
               </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <!-- Dev Environment -->
    <child>
      <object class="AdwPreferencesPage">
        <property name="visible">True</property>
        <property name="title">Dev</property>
        <property name="icon-name">applications-development-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup" id="dev_group">
             <property name="title">Layers</property>
            <child>
               <object class="AdwActionRow" id="dev_add_row">
                   <property name="title">Add New Layer</property>
                   <property name="activatable">True</property>
                   <child type="prefix">
                        <object class="GtkImage">
                            <property name="icon-name">list-add-symbolic</property>
                        </object>
                   </child>
               </object>
            </child>
          </object>
        </child>
      </object>
    </child>

  </template>
</interface>
