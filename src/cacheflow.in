#!@PYTHON@

# SPDX-License-Identifier: MIT

import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
pythondir = '@pythondir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
sys.path.insert(1, pythondir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('cacheflow', localedir)
locale.textdomain('cacheflow')
gettext.install('cacheflow', localedir)

os.environ['GI_TYPELIB_PATH'] = '@gi_typelib_path@'

if __name__ == '__main__':
    import gi

    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'cacheflow.gresource'))
    resource._register()

    from cacheflow import main
    sys.exit(main.main(VERSION))
