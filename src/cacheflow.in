#!@PYTHON@

# SPDX-License-Identifier: MIT

import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
pythondir = '@pythondir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
sys.path.insert(1, pythondir)
signal.signal(signal.SIGINT, signal.SIG_DFL)

try:
    locale.bindtextdomain('cacheflow', localedir)
    locale.textdomain('cacheflow')
except AttributeError:
    # macOS/libintl compatibility: locale module might not have bindtextdomain.
    if hasattr(gettext, 'bindtextdomain'):
        gettext.bindtextdomain('cacheflow', localedir)
    if hasattr(gettext, 'textdomain'):
        gettext.textdomain('cacheflow')

gettext.install('cacheflow', localedir)

# This block must run first, before any other application modules are imported.
# We import the necessary GTK libraries and load the application's resources.
try:
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Adw', '1')
    from gi.repository import Gio, GLib
except (ImportError, ValueError) as e:
    sys.exit(f"FATAL: Could not load GTK/Adwaita. {e}")

try:
    # Load the GResource bundle
    resource_path = os.path.join(pkgdatadir, 'cacheflow.gresource')
    resource = Gio.Resource.load(resource_path)
    Gio.Resource._register(resource)
except GLib.Error as e:
    sys.exit(f"FATAL: Failed to load application resources from {resource_path}. {e}")

# Now that resources are loaded and registered, we can safely import and run the application.
if __name__ == '__main__':
    from cacheflow import main
    sys.exit(main.main(VERSION))
